# 공공데이터포털(data.go.kr) 인증키 — K-Startup 사업공고(15125364), 기업마당(15157820)
KSTARTUP_SERVICE_KEY=
BIZINFO_SERVICE_KEY=
# 기업마당 자체 API 인증키(crtfcKey). 상용 이용 전 사전 협의 필요
BIZINFO_CRTFC_KEY=
# LLM
ANTHROPIC_API_KEY=
NOTICEDELTA_LLM_MODE=replay
# 원문 저장소 (설계 7.2). local(기본, NOTICEDELTA_BLOB_DIR) 또는 s3(로컬 SeaweedFS·R2, uv sync --extra s3)
# 로컬 SeaweedFS 계정은 infra/seaweedfs/s3.json (noticedelta / noticedelta-dev)
NOTICEDELTA_BLOB_BACKEND=local
NOTICEDELTA_BLOB_DIR=data/blobs
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=noticedelta
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# DB. 기본은 SQLite 파일. 로컬 PostgreSQL(docker compose)은 uv sync --extra postgres 후
# postgresql+psycopg://noticedelta:noticedelta@localhost:5433/noticedelta
DATABASE_URL=sqlite:///data/dev.db
