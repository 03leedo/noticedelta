# 공공데이터포털(data.go.kr) 인증키 — K-Startup 사업공고(15125364), 기업마당(15157820)
KSTARTUP_SERVICE_KEY=
BIZINFO_SERVICE_KEY=
# 기업마당 자체 API 인증키(crtfcKey). 상용 이용 전 사전 협의 필요
BIZINFO_CRTFC_KEY=
# LLM
ANTHROPIC_API_KEY=
NOTICEDELTA_LLM_MODE=replay
# LLM 공급자: anthropic(기본) 또는 pickle(부산대 피클 게이트웨이, OpenAI 호환, https://github.com/PNUops/pickle-llm-gateway)
NOTICEDELTA_LLM_PROVIDER=anthropic
# 피클 키는 pickle- 로 시작. 모델 목록은 GET $PICKLE_BASE_URL/models. 기본 pickle-general(학교 모델, 무료)
# 유료 모델(anthropic/..., openai/... 등)은 키의 달러 한도에서 빠진다. 쓰려면 PICKLE_ALLOW_PAID=1
PICKLE_API_KEY=
PICKLE_BASE_URL=https://llm.pcl.kr/v1
PICKLE_MODEL=
PICKLE_ALLOW_PAID=
# 원문 저장소 (설계 7.2). local(기본, NOTICEDELTA_BLOB_DIR) 또는 s3(로컬 SeaweedFS·R2, uv sync --extra s3)
# 로컬 SeaweedFS 계정은 infra/seaweedfs/s3.json (noticedelta / noticedelta-dev)
NOTICEDELTA_BLOB_BACKEND=local
NOTICEDELTA_BLOB_DIR=data/blobs
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=noticedelta
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# DB. 기본은 SQLite 파일. 로컬 PostgreSQL(docker compose)은 uv sync --extra postgres 후
# postgresql+psycopg://noticedelta:noticedelta@localhost:5433/noticedelta
DATABASE_URL=sqlite:///data/dev.db

# MCP 서버(scripts/mcp_server.py)가 내 정보 도구(get_profile, check, explain)를 쓸 때의 내 링크 토큰.
# 웹 주소 /p/<토큰>의 토큰이다. 웹의 "내 정보 고치기"에서 에이전트 도우미(선택)에 동의해야 값이 나온다.
# NOTICEDELTA_MCP_LINK=
